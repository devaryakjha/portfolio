---
const { project } = Astro.props;
const stories: Record<string, { intro: string; steps: { title: string; text: string; labels?: string[]; code?: string; note: string }[]; closing: string }> = {
  tagflow: {
    intro: 'Tagflow started as an HTML renderer for Flutter. The beta takes that a little further: apps can now work with structured documents directly, while keeping HTML support for content that already uses it.',
    steps: [
      { title: 'Start with the content you have.', text: 'If your content is already HTML, you can pass it to the adapter. It goes through the same runtime as a native document and renders as Flutter widgets.', code: 'Tagflow.html(html: htmlContent);', labels: ['HTML content', 'Tagflow runtime', 'Flutter widgets'], note: 'API example · htmlContent is supplied by your app.' },
      { title: 'Let the document change.', text: 'For structured content, you can skip the HTML step. The runtime accepts documents, validates trusted app-controlled JSON, and applies patches when content changes. That gives the app a way to update part of a document without sending everything through HTML again.', code: 'Tagflow.document(document);', labels: ['Document', 'Apply patches', 'Updated content'], note: 'Runtime flow · document is a TagflowDocument created by your app.' },
    ],
    closing: 'The native runtime is still in beta, so APIs may change. The stable HTML-renderer line remains available if that is all your app needs.',
  },
  gpuicn: {
    intro: 'gpuicn brings editable UI components to Rust and GPUI. The idea is simple: add the source to your app, then change the details yourself. It follows the same source distribution approach as shadcn/ui.',
    steps: [
      { title: 'Add only what you need.', text: 'Once the CLI and registry are set up, you can add individual components. The installer copies the Rust source and shared modules into your app. There is no CLI dependency at runtime.', code: 'gpuicn add button sidebar', labels: ['Choose components', 'Copy Rust source', 'Use in your app'], note: 'CLI example · Requires the matching CLI, registry, and GPUI dependencies. See the setup guide.' },
      { title: 'Make it fit your app.', text: 'The source stays editable, so styling and behavior can change with your interface. The catalog includes examples and real GPUI previews in the browser to help you decide where to start.', labels: ['Browse examples', 'Edit the source', 'Review updates'], note: 'Working with the library · Updates still need a source review.' },
    ],
    closing: 'This is still beta software. Keep the dependency and registry versions together, and review changes before replacing source you have edited.',
  },
  bonsai: {
    intro: 'Bonsai is an early exploration of a native macOS Git client, built with Rust and GPUI. There is not a finished app to walk through yet. For now, this is the direction of the project.',
    steps: [
      { title: 'Make everyday Git work easier to follow.', text: 'The design question is how to make a repository, its changes, and its history clear in one native interface. The sequence below is a sketch of that workflow, not a claim about features that have shipped.', labels: ['Open a repository', 'Review changes', 'Understand the history'], note: 'Proposed workflow · Not a screenshot or a shipped feature list.' },
      { title: 'Build it in the open.', text: 'The project is still in development. I will add real screens and more detail here as there is something useful to show. The repository is the place to follow along for now.', labels: ['Rust', 'GPUI', 'macOS'], note: 'Project direction · Early development.' },
    ],
    closing: 'There is no release to recommend yet. If this kind of Git client interests you, you can follow the work on GitHub.',
  },
  anpec: {
    intro: 'Android apps run on a wide range of hardware. Anpec is a small Flutter plugin that helps an app understand the device it is running on, so it can make more sensible choices about expensive features.',
    steps: [
      { title: 'Ask about the device.', text: 'The plugin returns a performance class: unknown, low, average, or high. It uses Android media performance class when available, with hardware information as a fallback.', code: 'final classifier = PerformanceClassifier.instance;\nfinal performanceClass =\n    await classifier.getPerformanceClass();', labels: ['Android device', 'Classification', 'App decision'], note: 'API example · Android only. Classification is a guide, not a benchmark.' },
      { title: 'Choose what your app should do.', text: 'Your app still decides how to use the result. You might reduce costly effects on a lower-end device or choose a lighter processing path. The plugin supplies the classification; it does not change the interface for you.', code: 'if (performanceClass == PerformanceClass.low) {\n  // Choose a lighter experience in your app.\n}', note: 'Integration example · Handle unknown results with a sensible default.' },
    ],
    closing: 'Anpec is focused on Android. Treat its result as one input to your app’s behavior, and check the experience on real devices.',
  },
  seisei: {
    intro: 'Seisei explores a small but useful idea: model output should be something an app can check before using it. It is an early set of Dart and Flutter packages for typed generation, validation, and testing.',
    steps: [
      { title: 'Say what the app expects.', text: 'A schema describes the response shape. In the offline example, a summary must contain a text field. The response passes through validation before the app turns it into its own Dart type.', code: "const schema = ObjectSchema(\n  name: 'Summary',\n  requiredStringFields: {'text'},\n);", labels: ['Model response', 'Schema validation', 'App data'], note: 'Excerpt from the offline CLI example · Validation can reject a response.' },
      { title: 'Test without calling a model.', text: 'A fake provider makes it possible to exercise the same contracts with a known response. The basic CLI example runs offline, so it can check the app’s handling without depending on a live model service.', labels: ['Fake provider', 'Known response', 'Repeatable test'], note: 'Offline example · No Apple or cloud model call.' },
    ],
    closing: 'This is experimental software. The core stays provider-neutral, with Apple integration and other adapters in separate packages. It is not a complete AI backend.',
  },
};
const story = stories[project.slug];
---
<section class="project-story" aria-label={`Inside ${project.name}`}>
  <div class="intro"><p class="small-label">ABOUT THE PROJECT</p><h2>A little more about {project.name}.</h2><p>{story.intro}</p></div>
  {story.steps.map((step, i) => <figure>
    <figcaption><p class="small-label">0{i + 1} / {project.name}</p><h2>{step.title}</h2><p>{step.text}</p></figcaption>
    <div class="example">
      {step.labels && <ol class="flow" aria-label="Workflow">{step.labels.map(label => <li>{label}</li>)}</ol>}
      {step.code && <pre tabindex="0" aria-label={`${project.name} code example`}><code>{step.code}</code></pre>}
    </div>
    <p class="note">{step.note}</p>
  </figure>)}
  <div class="ending"><h2>Where things stand.</h2><p>{story.closing}</p><a class="grid-button" href={project.href}>Explore {project.name} ↗</a><a class="source" href={project.source}>Read the source ↗</a></div>
</section>
<style>
  .project-story { margin: 60px 0; }
  .intro { max-width: 680px; margin: 65px auto; }
  h2 { font-size: clamp(28px,4vw,44px); font-weight: 500; letter-spacing: -.055em; line-height: 1.15; margin: 15px 0 22px; }
  .intro > p:last-child, figcaption > p:last-child, .ending > p { font-size: 16px; line-height: 1.85; color: light-dark(#53524e,#aaa); }
  figure, .ending { margin: 65px 0; padding-top: 35px; border-top: 1px solid light-dark(#d3d2ce,#333); }
  figcaption { max-width: 760px; margin-bottom: 24px; }
  .example { border: 1px solid light-dark(#d3d2ce,#333); background: light-dark(#f0efec,#101010); border-radius: 8px; padding: 40px; }
  .flow { list-style: none; padding: 0; margin: 0; display: flex; align-items: center; gap: 30px; }
  .flow li { flex: 1; position: relative; text-align: center; padding: 24px 12px; border: 1px solid light-dark(#c4c3bf,#444); font: 14px/1.5 'Courier New',monospace; }
  .flow li + li::before { content: '→'; position: absolute; left: -25px; top: 50%; transform: translateY(-50%); }
  pre { margin: 0; overflow-x: auto; font: 14px/1.8 'Courier New',monospace; tab-size: 2; }
  .flow + pre { margin-top: 30px; padding-top: 25px; border-top: 1px solid light-dark(#d3d2ce,#333); }
  .note { margin-top: 12px; color: light-dark(#62615d,#aaa); font: 11px/1.6 'Courier New',monospace; }
  .source { display: inline-block; margin: 24px; font-size: 13px; }
  @media(max-width:700px) { .example { padding: 22px; } .flow { flex-direction: column; } .flow li { width: 100%; } .flow li + li::before { content: '↓'; left: 50%; top: -25px; transform: translateX(-50%); } pre { font-size: 12px; } figure,.ending { margin-block: 40px; } }
</style>
