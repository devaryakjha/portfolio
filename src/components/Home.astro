---
import { work } from '../data/work';
import { getAllPosts } from '../utils/blog';
import Artwork from './ProjectArtwork.astro';
import Workbench from './Workbench.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/images/grid/arya-line.png';
import portraitMask from '../../public/grid/portrait-mask.svg?raw';
const portraitOutline = portraitMask.match(/ d="([^"]+)"/)![1];
---
<section class="grid-hero"><div class="grid-hero-copy"><p class="small-label"><span class="status-dot"></span> Hi, I’m Arya. / Software engineer</p><h1>From the<br />interface.<br /><span>To the internals.</span></h1><p>I’m a software engineer at Zerodha.<br />Outside work, I make open-source tools for the problems I keep running into.</p><a class="grid-button" href="#work">Browse projects <span>↓</span></a></div><div class="system-art portrait-art"><div class="system-coordinates"><span>The person behind the code</span><span>01 / Arya</span></div><button class="portrait-sticker" type="button" aria-label="Peel portrait sticker" aria-describedby="sticker-instructions" aria-pressed="false" disabled><svg class="portrait-outline" viewBox="0 0 1254 1254" aria-hidden="true"><path d={portraitOutline} /></svg><span class="portrait-peel"><span class="portrait-face"><Image class="grid-portrait" src={avatar} widths={[240,400,640]} sizes="(max-width:700px) 240px, 320px" width={320} height={320} alt="Line drawing of Arya with glasses and a crooked grin" loading="eager" draggable="false" /></span><span class="portrait-backing" aria-hidden="true"></span></span></button><span id="sticker-instructions" class="sticker-instructions">Drag an edge to peel. Left or Up arrow peels gradually; Right or Down lays it flat. Escape resets.</span><div class="system-coordinates"><span>Aryakumar Jha</span><span>Bangalore, India</span></div></div></section>
<div class="grid-ticker"><span>Native applications</span><span>Developer tools</span><span>Release infrastructure</span><span>Open source</span></div>
<section id="work" class="grid-work"><header class="grid-section-heading"><h2>Project directory<span> / 06</span></h2><span>Ideas, in working form.</span></header><div class="grid-projects">{work.map(p => <article><a class="grid-art-link" href={`/projects/${p.slug}`} aria-label={`Explore ${p.name}`}><Artwork kind={p.slug} /></a><div class="grid-project-info"><p class="small-label">{p.language}<span>↗</span></p><h3><a href={`/projects/${p.slug}`}>{p.name}</a></h3><p>{p.short}</p><span class="grid-state">{p.state}</span></div></article>)}</div></section>
<Workbench />
<section class="grid-bottom"><div id="about"><p class="small-label">The person behind the code</p><h2>Hi, I’m Arya.</h2><p>Based in Bangalore. Most of my work is in Flutter and Dart, with a growing interest in Rust and Go. I like understanding how things work, then finding a simpler way to put them together.</p><a href="https://github.com/devaryakjha">github.com/devaryakjha ↗</a></div><div><p class="small-label">Field notes</p>{getAllPosts().map(p => <a class="grid-post" href={`/blog/${p.slug}`}><span>{new Date(p.frontmatter.date).getFullYear()}</span><h3>{p.frontmatter.shortTitle || p.frontmatter.title}</h3><b>↗</b></a>)}<a href={`/blog`}>Open the journal ↗</a></div></section>

<script>
  import { mountSticker } from '../scripts/sticker';
  mountSticker(document.querySelector<HTMLButtonElement>('.portrait-sticker')!);
</script>
