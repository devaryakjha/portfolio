---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllPosts } from '../../utils/blog';
import { formatDate } from '../../utils/date';
---
<SiteLayout ogImage="/blog/og.png" description="Notes by Aryakumar Jha on making software, solving small problems, and learning along the way." title="Writing — Aryakumar Jha"><div class="journal"><header class="journal-header"><p class="small-label">Thoughts, occasionally written down.</p><h1>Field notes_</h1><p>On making software, solving small problems, and learning along the way.</p></header><div class="journal-list">{getAllPosts().map(p=><a href={`/blog/${p.slug}`}><time datetime={p.frontmatter.date}>{formatDate(p.frontmatter.date)}</time><div><h2>{p.frontmatter.shortTitle || p.frontmatter.title}</h2><p>{p.frontmatter.summary ?? p.frontmatter.excerpt}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></SiteLayout>
