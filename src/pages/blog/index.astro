---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllPosts } from '../../utils/blog';
import { formatDate } from '../../utils/date';
const posts = await getAllPosts();
---
<SiteLayout ogImage="/blog/og.png" description="Writing by Aryakumar Jha on making software, solving small problems, and learning along the way." title="Writing — Aryakumar Jha"><div class="journal"><header class="journal-header"><p class="small-label">Thoughts, occasionally written down.</p><h1>Writing_</h1><p>On making software, solving small problems, and learning along the way. Follow along with the <a href="/rss.xml">RSS feed</a>.</p></header><div class="journal-list">{posts.map(p=><a href={`/blog/${p.id}`}><time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time><div><h2>{p.data.shortTitle || p.data.title}</h2><p>{p.data.description}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></SiteLayout>
