---
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllPosts, lastModified, type BlogPost } from '../../utils/blog';
import { site, person } from '../../data/site';
import { formatDate } from '../../utils/date';
export async function getStaticPaths() { return (await getAllPosts()).map(post=>({params:{slug:post.id},props:{post}})); }
const { post } = Astro.props as { post: BlogPost };
const { Content } = await render(post);
const url = `${site.url}/blog/${post.id}`;
const published = post.data.date;
const modified = lastModified(post);
const structuredData = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: published.toISOString(),
  dateModified: modified.toISOString(),
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: `${site.url}/blog/${post.id}/og.png`,
  author: person,
  publisher: person,
}, {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: `${site.url}/blog` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
}];
---
<SiteLayout structuredData={structuredData} ogType="article" article={{ published, modified }} ogImage={`/blog/${post.id}/og.png`} description={post.data.description} title={`${post.data.title} — Aryakumar Jha`}><article class="reading-page"><header class="reading-header"><a class="back" href="/blog">← All writing</a><div class="reading-meta"><a href="/about" rel="author">Aryakumar Jha</a><time datetime={published.toISOString()}>{formatDate(published)}</time></div><h1>{post.data.title}</h1></header><div class="reading-body"><Content /></div></article></SiteLayout>
